 <launch>
    <!--This launch file starts four nodes: 
    'generator', 'filter', 'controller', 'predictor' from the cr_week6_test package-->

    <node pkg="cr_week6_test" name="generator" type="interaction_generator.py"/>
    <node pkg="cr_week6_test" name="filter" type="perception_filter.py"/>
    <node pkg="cr_week6_test" name="controller" type="robot_controller.py"/>
    <node pkg="cr_week6_test" name="predictor" type="robot_expression_prediction.py"/>

</launch>

